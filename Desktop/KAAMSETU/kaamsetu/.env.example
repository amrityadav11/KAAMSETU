# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://kaamsetu_user:your_password@cluster0.xxxxx.mongodb.net/kaamsetu?retryWrites=true&w=majority

# JWT configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars_1a2b3c4d5e6f
JWT_EXPIRES_IN=7d

# Client URL (frontend domain)
# Development: http://localhost:5173
# Production: https://your-domain.vercel.app
CLIENT_URL=http://localhost:5173

# Cloudinary credentials (free tier available at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay credentials (test keys for development)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Node environment
NODE_ENV=development

# Server port
PORT=5001

# Cookie secret (min 32 characters, random)
COOKIE_SECRET=your_long_random_secret_for_cookies_min_32_chars_1a2b3c4d5e

# Frontend API URL (for Vercel frontend to reach Render backend)
# Only needed in production
# VITE_API_URL=https://kaamsetu-api.onrender.com
